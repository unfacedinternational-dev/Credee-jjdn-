# Public Supabase project settings. The anon/publishable key is designed for browser use with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secret. Never prefix with NEXT_PUBLIC_ and never commit a real value.
# Only add this when a trusted server-side admin operation explicitly requires it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Do not use a static CEO password/secret in frontend code or as a substitute for Supabase auth.
# CEO access is granted by a server-controlled profiles.role = 'ceo' record.
